@model List<SmartPlace.Web.Services.StudentInterviewItem>

@{
    ViewData["Title"] = "Interviews";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                My Interviews
            </h2>

            <p class="text-muted mb-0">
                Upcoming interview rounds, results and instructions.
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Dashboard
        </a>

    </div>


    @if (Model == null || Model.Count == 0)
    {
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <h5 class="fw-bold">
                    No Interviews Scheduled
                </h5>

                <p class="text-muted mb-0">
                    Interview rounds will appear here once scheduled.
                </p>

            </div>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var interview in Model)
            {
                var scheduledDateText =
                    interview.ScheduledDate
                        .ToLocalTime()
                        .ToString("dd MMM yyyy, hh:mm tt");

                var result =
                    string.IsNullOrWhiteSpace(interview.Result)
                        ? "Pending"
                        : interview.Result;

                <div class="col-lg-6">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body p-4">

                            <div class="d-flex justify-content-between align-items-start mb-3">

                                <div>

                                    <h4 class="fw-bold mb-1">
                                        @interview.RoundName
                                    </h4>

                                    <div class="text-muted">
                                        @(string.IsNullOrWhiteSpace(interview.JobTitle)
                                            ? "Job"
                                            : interview.JobTitle)
                                        ·
                                        @(string.IsNullOrWhiteSpace(interview.CompanyName)
                                            ? "Company"
                                            : interview.CompanyName)
                                    </div>

                                </div>


                                @if (string.Equals(
                                    interview.Status,
                                    "Completed",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-secondary">
                                        Completed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">
                                        @(string.IsNullOrWhiteSpace(interview.Status)
                                            ? "Scheduled"
                                            : interview.Status)
                                    </span>
                                }

                            </div>


                            <div class="mb-3">

                                <small class="text-muted">
                                    Scheduled
                                </small>

                                <div class="fw-semibold">
                                    @scheduledDateText
                                </div>

                            </div>


                            <div class="mb-3">

                                <small class="text-muted">
                                    Mode
                                </small>

                                <div class="fw-semibold">
                                    @interview.Mode
                                </div>

                            </div>


                            @if (!string.IsNullOrWhiteSpace(
                                interview.LocationOrLink))
                            {
                                <div class="mb-3">

                                    <small class="text-muted">
                                        Location / Link
                                    </small>

                                    <div class="fw-semibold">

                                        @if (interview.LocationOrLink.StartsWith(
                                            "http",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <a href="@interview.LocationOrLink"
                                               target="_blank"
                                               rel="noopener noreferrer">
                                                Open Interview Link
                                            </a>
                                        }
                                        else
                                        {
                                            @interview.LocationOrLink
                                        }

                                    </div>

                                </div>
                            }


                            <div class="mb-3">

                                <small class="text-muted">
                                    Result
                                </small>

                                <div>

                                    @if (result.Equals(
                                        "Passed",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-success">
                                            Passed
                                        </span>
                                    }
                                    else if (result.Equals(
                                        "Failed",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-danger">
                                            Failed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }

                                </div>

                            </div>


                            @if (!string.IsNullOrWhiteSpace(
                                interview.Remarks))
                            {
                                <div>

                                    <small class="text-muted">
                                        Remarks
                                    </small>

                                    <div class="fw-semibold">
                                        @interview.Remarks
                                    </div>

                                </div>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>