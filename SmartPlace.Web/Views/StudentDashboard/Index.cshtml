@model SmartPlace.Web.Services.StudentProfile

@{
    ViewData["Title"] = "Student Dashboard";

    var academicProfileIncomplete =
        ViewBag.AcademicProfileIncomplete
        is bool value
        && value;

    var hasSkills =
        Model.Skills != null &&
        Model.Skills.Count > 0;

    var profileStatus =
        academicProfileIncomplete
            ? "Incomplete"
            : "Complete";
}


<div class="student-dashboard">

    <!-- ==================================================
         WELCOME / HERO
    =================================================== -->

    <div class="card border-0 shadow-sm mb-4 overflow-hidden">

        <div class="card-body p-4 p-lg-5">

            <div class="row align-items-center g-4">

                <div class="col-lg-8">

                    <div class="d-flex align-items-center gap-2 mb-3">

                        <span class="badge bg-primary px-3 py-2">
                            Student Portal
                        </span>

                        @if (academicProfileIncomplete)
                        {
                            <span class="badge
                                bg-warning
                                text-dark
                                px-3 py-2">
                                Profile Incomplete
                            </span>
                        }
                        else
                        {
                            <span class="badge
                                bg-success
                                px-3 py-2">
                                Profile Complete
                            </span>
                        }

                    </div>


                    <h1 class="fw-bold mb-2">
                        Welcome back,
                        @Model.FullName
                    </h1>


                    <p class="text-muted mb-0 fs-5">
                        Track your academic profile,
                        discover eligible opportunities
                        and manage your placement journey.
                    </p>

                </div>


                <div class="col-lg-4">

                    <div class="d-flex
                        flex-column
                        flex-sm-row
                        flex-lg-column
                        gap-2
                        justify-content-lg-end">

                        <a asp-action="Jobs"
                           class="btn btn-primary btn-lg">

                            Explore Jobs

                        </a>


                        <a asp-action="CompleteProfile"
                           class="btn
                            btn-outline-secondary
                            btn-lg">

                            Edit Academic Profile

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ==================================================
         INCOMPLETE PROFILE WARNING
    =================================================== -->
    @if (academicProfileIncomplete)
    {
        <div class="alert
            alert-warning
            border-0
            shadow-sm
            d-flex
            flex-column
            flex-md-row
            justify-content-between
            align-items-md-center
            gap-3
            mb-4">

            <div>

                <div class="fw-bold mb-1">
                    Complete your academic profile
                </div>

                <div>
                    Your 10th and 12th percentages
                    are required before SmartPlace can
                    accurately calculate job eligibility.
                </div>

            </div>


            <a asp-action="CompleteProfile"
               class="btn btn-warning flex-shrink-0">

                Complete Profile

            </a>

        </div>
    }


    <!-- ==================================================
         SECTION HEADER
    =================================================== -->

    <div class="d-flex
        justify-content-between
        align-items-end
        mb-3">

        <div>

            <h4 class="fw-bold mb-1">
                Academic Overview
            </h4>

            <p class="text-muted mb-0">
                Your academic details used for
                placement eligibility.
            </p>

        </div>

        <span class="badge
            @(academicProfileIncomplete
                ? "bg-warning text-dark"
                : "bg-success")
            px-3 py-2">

            @profileStatus

        </span>

    </div>


    <!-- ==================================================
         ACADEMIC SUMMARY
    =================================================== -->

    <div class="row g-3 mb-5">


        <!-- 10TH -->

        <div class="col-sm-6 col-md-4 col-xl-2">

            <div class="card
                border-0
                shadow-sm
                h-100">

                <div class="card-body p-3">

                    <div class="d-flex
                        justify-content-between
                        align-items-start
                        mb-3">

                        <small class="text-muted fw-semibold">
                            10TH STANDARD
                        </small>

                        <span class="badge
                            bg-primary-subtle
                            text-primary">
                            %
                        </span>

                    </div>


                    @if (Model.TenthPercentage > 0)
                    {
                        <div class="fs-3 fw-bold">
                            @Model.TenthPercentage%
                        </div>

                        <small class="text-success">
                            Recorded
                        </small>
                    }
                    else
                    {
                        <div class="fs-4 fw-bold text-warning">
                            Pending
                        </div>

                        <small class="text-muted">
                            Add percentage
                        </small>
                    }

                </div>

            </div>

        </div>


        <!-- 12TH -->

        <div class="col-sm-6 col-md-4 col-xl-2">

            <div class="card
                border-0
                shadow-sm
                h-100">

                <div class="card-body p-3">

                    <div class="d-flex
                        justify-content-between
                        align-items-start
                        mb-3">

                        <small class="text-muted fw-semibold">
                            12TH STANDARD
                        </small>

                        <span class="badge
                            bg-primary-subtle
                            text-primary">
                            %
                        </span>

                    </div>


                    @if (Model.TwelfthPercentage > 0)
                    {
                        <div class="fs-3 fw-bold">
                            @Model.TwelfthPercentage%
                        </div>

                        <small class="text-success">
                            Recorded
                        </small>
                    }
                    else
                    {
                        <div class="fs-4 fw-bold text-warning">
                            Pending
                        </div>

                        <small class="text-muted">
                            Add percentage
                        </small>
                    }

                </div>

            </div>

        </div>


        <!-- CGPA -->

        <div class="col-sm-6 col-md-4 col-xl-2">

            <div class="card
                border-0
                shadow-sm
                h-100">

                <div class="card-body p-3">

                    <small class="text-muted fw-semibold">
                        CGPA
                    </small>


                    <div class="fs-3 fw-bold mt-3">
                        @Model.CGPA
                    </div>


                    <small class="text-muted">
                        Out of 10
                    </small>

                </div>

            </div>

        </div>


        <!-- BACKLOGS -->

        <div class="col-sm-6 col-md-4 col-xl-2">

            <div class="card
                border-0
                shadow-sm
                h-100">

                <div class="card-body p-3">

                    <small class="text-muted fw-semibold">
                        BACKLOGS
                    </small>


                    <div class="fs-3 fw-bold mt-3">
                        @Model.Backlogs
                    </div>


                    @if (Model.Backlogs == 0)
                    {
                        <small class="text-success">
                            No active backlogs
                        </small>
                    }
                    else
                    {
                        <small class="text-warning">
                            Current backlogs
                        </small>
                    }

                </div>

            </div>

        </div>


        <!-- GRADUATION -->

        <div class="col-sm-6 col-md-4 col-xl-2">

            <div class="card
                border-0
                shadow-sm
                h-100">

                <div class="card-body p-3">

                    <small class="text-muted fw-semibold">
                        GRADUATION
                    </small>


                    <div class="fs-3 fw-bold mt-3">
                        @Model.GraduationYear
                    </div>


                    <small class="text-muted">
                        Graduation year
                    </small>

                </div>

            </div>

        </div>


        <!-- DEPARTMENT -->

        <div class="col-sm-6 col-md-4 col-xl-2">

            <div class="card
                border-0
                shadow-sm
                h-100">

                <div class="card-body p-3">

                    <small class="text-muted fw-semibold">
                        DEPARTMENT
                    </small>


                    <div class="fw-bold mt-3">

                        @(Model.Department
                            ?? "Not Assigned")

                    </div>


                    <small class="text-muted">
                        Academic branch
                    </small>

                </div>

            </div>

        </div>

    </div>


    <!-- ==================================================
         PLACEMENT JOURNEY HEADER
    =================================================== -->

    <div class="mb-3">

        <h4 class="fw-bold mb-1">
            Placement Journey
        </h4>

        <p class="text-muted mb-0">
            Everything you need from job discovery
            to final placement.
        </p>

    </div>


    <!-- ==================================================
         MAIN FEATURE CARDS
    =================================================== -->

    <div class="row g-4 mb-5">


        <!-- JOBS -->

        <div class="col-md-6 col-xl-4">

            <div class="card
                border-0
                shadow-sm
                h-100">

                <div class="card-body p-4
                    d-flex
                    flex-column">

                    <div class="d-flex
                        justify-content-between
                        align-items-start
                        mb-4">

                        <div style="
                            width: 48px;
                            height: 48px;
                            border-radius: 14px;
                            background: rgba(37,99,235,.10);
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            font-size: 1.5rem;
                            ">
                            ◈
                        </div>


                        <span class="badge
                            bg-primary-subtle
                            text-primary">
                            Opportunities
                        </span>

                    </div>


                    <h5 class="fw-bold">
                        Jobs & Eligibility
                    </h5>


                    <p class="text-muted flex-grow-1">
                        Browse all published jobs and
                        instantly see which opportunities
                        match your academic eligibility.
                    </p>


                    @if (academicProfileIncomplete)
                    {
                        <a asp-action="CompleteProfile"
                           class="btn btn-warning w-100">

                            Complete Academic Profile

                        </a>
                    }
                    else
                    {
                        <a asp-action="Jobs"
                           class="btn btn-primary w-100">

                            Explore All Jobs

                        </a>
                    }

                </div>

            </div>

        </div>


        <!-- AI RECOMMENDATIONS -->

        <div class="col-md-6 col-xl-4">

            <div class="card
                border-0
                shadow-sm
                h-100">

                <div class="card-body p-4
                    d-flex
                    flex-column">

                    <div class="d-flex
                        justify-content-between
                        align-items-start
                        mb-4">

                        <div style="
                            width: 48px;
                            height: 48px;
                            border-radius: 14px;
                            background: rgba(124,58,237,.10);
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            font-size: 1.5rem;
                            ">
                            ✦
                        </div>


                        <span class="badge
                            bg-info-subtle
                            text-info-emphasis">
                            AI Powered
                        </span>

                    </div>


                    <h5 class="fw-bold">
                        AI Job Recommendations
                    </h5>


                    <p class="text-muted flex-grow-1">
                        SmartPlace ranks academically
                        eligible opportunities according
                        to skills extracted from your resume.
                    </p>


                    @if (academicProfileIncomplete)
                    {
                        <button type="button"
                                class="btn
                            btn-secondary
                            w-100"
                                disabled>

                            Complete Academic Profile

                        </button>
                    }
                    else if (!hasSkills)
                    {
                        <a asp-action="Resume"
                           class="btn
                            btn-outline-primary
                            w-100">

                            Extract Skills First

                        </a>
                    }
                    else
                    {
                        <a asp-action="Recommendations"
                           class="btn btn-primary w-100">

                            View AI Recommendations

                        </a>
                    }

                </div>

            </div>

        </div>


        <!-- RESUME -->

        <div class="col-md-6 col-xl-4">

            <div class="card
                border-0
                shadow-sm
                h-100">

                <div class="card-body p-4
                    d-flex
                    flex-column">

                    <div class="d-flex
                        justify-content-between
                        align-items-start
                        mb-4">

                        <div style="
                            width: 48px;
                            height: 48px;
                            border-radius: 14px;
                            background: rgba(16,185,129,.10);
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            font-size: 1.5rem;
                            ">
                            ▤
                        </div>


                        @if (hasSkills)
                        {
                            <span class="badge bg-success">
                                @Model.Skills.Count Skills
                            </span>
                        }
                        else
                        {
                            <span class="badge
                                bg-secondary">
                                No Skills
                            </span>
                        }

                    </div>


                    <h5 class="fw-bold">
                        Resume & AI Skills
                    </h5>


                    <p class="text-muted flex-grow-1">
                        Upload your resume and use
                        SmartPlace AI to automatically
                        detect technical skills.
                    </p>


                    <a asp-action="Resume"
                       class="btn
                        btn-outline-primary
                        w-100">

                        Manage Resume & Skills

                    </a>

                </div>

            </div>

        </div>


        <!-- APPLICATIONS -->

        <div class="col-md-6 col-xl-4">

            <div class="card
                border-0
                shadow-sm
                h-100">

                <div class="card-body p-4
                    d-flex
                    flex-column">

                    <div style="
                        width: 48px;
                        height: 48px;
                        border-radius: 14px;
                        background: rgba(14,165,233,.10);
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-size: 1.5rem;
                        margin-bottom: 1.5rem;
                        ">
                        ▣
                    </div>


                    <h5 class="fw-bold">
                        My Applications
                    </h5>


                    <p class="text-muted flex-grow-1">
                        Track every job application
                        and follow its current recruitment
                        status.
                    </p>


                    <a asp-action="MyApplications"
                       class="btn
                        btn-outline-primary
                        w-100">

                        Track Applications

                    </a>

                </div>

            </div>

        </div>


        <!-- INTERVIEWS -->

        <div class="col-md-6 col-xl-4">

            <div class="card
                border-0
                shadow-sm
                h-100">

                <div class="card-body p-4
                    d-flex
                    flex-column">

                    <div style="
                        width: 48px;
                        height: 48px;
                        border-radius: 14px;
                        background: rgba(245,158,11,.12);
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-size: 1.5rem;
                        margin-bottom: 1.5rem;
                        ">
                        ◷
                    </div>


                    <h5 class="fw-bold">
                        Interviews
                    </h5>


                    <p class="text-muted flex-grow-1">
                        View scheduled interview rounds,
                        meeting information, results
                        and recruiter remarks.
                    </p>


                    <a asp-action="Interviews"
                       class="btn
                        btn-outline-primary
                        w-100">

                        View Interviews

                    </a>

                </div>

            </div>

        </div>


        <!-- PLACEMENT -->

        <div class="col-md-6 col-xl-4">

            <div class="card
                border-0
                shadow-sm
                h-100">

                <div class="card-body p-4
                    d-flex
                    flex-column">

                    <div style="
                        width: 48px;
                        height: 48px;
                        border-radius: 14px;
                        background: rgba(16,185,129,.10);
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-size: 1.5rem;
                        margin-bottom: 1.5rem;
                        ">
                        ★
                    </div>


                    <h5 class="fw-bold">
                        Placement Status
                    </h5>


                    <p class="text-muted flex-grow-1">
                        View your final placement,
                        selected company, offered package
                        and joining information.
                    </p>


                    <a asp-action="Placement"
                       class="btn
                        btn-outline-primary
                        w-100">

                        View Placement

                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- ==================================================
         SKILLS
    =================================================== -->

    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <div class="row
                align-items-center
                g-4">

                <div class="col-lg-4">

                    <div class="d-flex
                        align-items-center
                        gap-3">

                        <div style="
                            width: 52px;
                            height: 52px;
                            border-radius: 15px;
                            background: rgba(124,58,237,.10);
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            font-size: 1.5rem;
                            ">
                            ✦
                        </div>


                        <div>

                            <h5 class="fw-bold mb-1">
                                My AI-Detected Skills
                            </h5>

                            <div class="text-muted">
                                Used for intelligent
                                job matching
                            </div>

                        </div>

                    </div>

                </div>


                <div class="col-lg-8">

                    @if (hasSkills)
                    {
                        <div class="d-flex
                            flex-wrap
                            gap-2
                            justify-content-lg-end">

                            @foreach (var skill in Model.Skills)
                            {
                                <span class="badge
                                    rounded-pill
                                    bg-primary-subtle
                                    text-primary
                                    px-3
                                    py-2">

                                    @skill

                                </span>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="
                            d-flex
                            flex-column
                            flex-md-row
                            align-items-md-center
                            justify-content-lg-end
                            gap-3">

                            <span class="text-muted">
                                No skills have been
                                extracted yet.
                            </span>


                            <a asp-action="Resume"
                               class="btn
                                btn-sm
                                btn-primary">

                                Upload Resume

                            </a>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>