@model SmartPlace.Web.Services.StudentProfile

@{
    ViewData["Title"] = "Student Dashboard";

    var academicProfileIncomplete =
        ViewBag.AcademicProfileIncomplete
        is bool value
        && value;
}

<div class="container py-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    @if (academicProfileIncomplete)
    {
        <div class="alert alert-warning
            d-flex justify-content-between
            align-items-center">

            <div>

                <strong>
                    Academic profile incomplete
                </strong>

                <div class="small mt-1">
                    Add your 10th and 12th percentages
                    before checking placement eligibility.
                </div>

            </div>

            <a asp-action="CompleteProfile"
               class="btn btn-warning">
                Complete Profile
            </a>

        </div>
    }


    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Student Dashboard
            </h2>

            <p class="text-muted mb-0">
                Welcome back, @Model.FullName
            </p>

        </div>

        <a asp-action="CompleteProfile"
           class="btn btn-outline-primary">
            Edit Profile
        </a>

    </div>


    <!-- ACADEMIC SUMMARY -->

    <div class="row g-3 mb-4">

        <div class="col-md-4 col-lg-2">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <small class="text-muted">
                        10th
                    </small>

                    <div class="fs-3 fw-bold">

                        @if (Model.TenthPercentage > 0)
                        {
                            <span>
                                @Model.TenthPercentage%
                            </span>
                        }
                        else
                        {
                            <span class="text-warning">
                                Pending
                            </span>
                        }

                    </div>

                </div>
            </div>

        </div>


        <div class="col-md-4 col-lg-2">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <small class="text-muted">
                        12th
                    </small>

                    <div class="fs-3 fw-bold">

                        @if (Model.TwelfthPercentage > 0)
                        {
                            <span>
                                @Model.TwelfthPercentage%
                            </span>
                        }
                        else
                        {
                            <span class="text-warning">
                                Pending
                            </span>
                        }

                    </div>

                </div>
            </div>

        </div>


        <div class="col-md-4 col-lg-2">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <small class="text-muted">
                        CGPA
                    </small>

                    <div class="fs-3 fw-bold">
                        @Model.CGPA
                    </div>

                </div>
            </div>

        </div>


        <div class="col-md-4 col-lg-2">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <small class="text-muted">
                        Backlogs
                    </small>

                    <div class="fs-3 fw-bold">
                        @Model.Backlogs
                    </div>

                </div>
            </div>

        </div>


        <div class="col-md-4 col-lg-2">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <small class="text-muted">
                        Graduation
                    </small>

                    <div class="fs-3 fw-bold">
                        @Model.GraduationYear
                    </div>

                </div>
            </div>

        </div>


        <div class="col-md-4 col-lg-2">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <small class="text-muted">
                        Department
                    </small>

                    <div class="fw-bold mt-2">
                        @(Model.Department
                            ?? "Not Assigned")
                    </div>

                </div>
            </div>

        </div>

    </div>


    <!-- FEATURES -->

    <div class="row g-4">


        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <h5 class="fw-bold">
                        Jobs & Eligibility
                    </h5>

                    <p class="text-muted">
                        Explore all published jobs and see
                        exactly which ones you are eligible for.
                    </p>

                    @if (academicProfileIncomplete)
                    {
                        <a asp-action="CompleteProfile"
                           class="btn btn-warning">
                            Complete Academic Profile
                        </a>
                    }
                    else
                    {
                        <a asp-action="Jobs"
                           class="btn btn-primary">
                            Explore Jobs
                        </a>
                    }

                </div>
            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <h5 class="fw-bold">
                        Resume & AI Skills
                    </h5>

                    <p class="text-muted">
                        Upload your resume and automatically
                        extract technical skills for AI matching.
                    </p>

                    <a asp-action="Resume"
                       class="btn btn-primary">
                        Manage Resume
                    </a>

                </div>
            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <h5 class="fw-bold">
                        AI Job Recommendations
                    </h5>

                    <p class="text-muted">
                        Rank academically eligible jobs
                        according to your extracted skills.
                    </p>

                    @if (academicProfileIncomplete)
                    {
                        <button class="btn btn-secondary"
                                disabled>
                            Complete Academic Profile
                        </button>
                    }
                    else if (Model.Skills.Count == 0)
                    {
                        <a asp-action="Resume"
                           class="btn btn-outline-primary">
                            Extract Skills First
                        </a>
                    }
                    else
                    {
                        <a asp-action="Jobs"
                           class="btn btn-primary">
                            View AI Matches
                        </a>
                    }

                </div>
            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <h5 class="fw-bold">
                        Applications
                    </h5>

                    <p class="text-muted">
                        Track submitted applications and
                        current recruitment status.
                    </p>

                    <a asp-action="MyApplications"
                       class="btn btn-outline-primary">
                        My Applications
                    </a>

                </div>
            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <h5 class="fw-bold">
                        Interviews
                    </h5>

                    <p class="text-muted">
                        View interview rounds, schedules,
                        links and results.
                    </p>

                    <a asp-action="Interviews"
                       class="btn btn-outline-primary">
                        My Interviews
                    </a>

                </div>
            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <h5 class="fw-bold">
                        Placement
                    </h5>

                    <p class="text-muted">
                        View company, package, joining date
                        and final placement status.
                    </p>

                    <a asp-action="Placement"
                       class="btn btn-outline-primary">
                        Placement Status
                    </a>

                </div>
            </div>

        </div>


        <div class="col-12">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <h5 class="fw-bold">
                        My Skills
                    </h5>

                    @if (Model.Skills.Count > 0)
                    {
                        <div class="d-flex flex-wrap gap-2 mt-3">

                            @foreach (var skill
                                      in Model.Skills)
                            {
                                <span class="badge bg-secondary p-2">
                                    @skill
                                </span>
                            }

                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            Upload your resume to extract skills.
                        </p>
                    }

                </div>

            </div>

        </div>

    </div>

</div>