@model SmartPlace.Web.Services.StudentProfileRequest
@using SmartPlace.Web.Services

@{
    ViewData["Title"] = "Complete Profile";

    var departments =
        ViewBag.Departments as List<DepartmentItem>
        ?? new List<DepartmentItem>();
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-7 col-md-9">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4 p-md-5">

                    <div class="mb-4">

                        <h2 class="fw-bold mb-2">
                            Complete Your Profile
                        </h2>

                        <p class="text-muted mb-0">
                            Add your academic details so SmartPlace
                            can check job eligibility and generate
                            AI-powered recommendations.
                        </p>

                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.Error
                        </div>
                    }

                    <form asp-controller="StudentDashboard"
                          asp-action="CompleteProfile"
                          method="post">

                        <div class="mb-3">

                            <label asp-for="DepartmentId"
                                   class="form-label fw-semibold">
                                Department
                            </label>

                            <select asp-for="DepartmentId"
                                    class="form-select">

                                <option value="">
                                    Select your department
                                </option>

                                @foreach (var department in departments)
                                {
                                    <option value="@department.DepartmentId">
                                        @department.Name
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="DepartmentId"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="CGPA"
                                       class="form-label fw-semibold">
                                    CGPA
                                </label>

                                <input asp-for="CGPA"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       max="10"
                                       class="form-control"
                                       placeholder="e.g. 8.25" />

                                <span asp-validation-for="CGPA"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="Backlogs"
                                       class="form-label fw-semibold">
                                    Current Backlogs
                                </label>

                                <input asp-for="Backlogs"
                                       type="number"
                                       min="0"
                                       class="form-control"
                                       placeholder="e.g. 0" />

                                <span asp-validation-for="Backlogs"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <div class="mb-4">

                            <label asp-for="GraduationYear"
                                   class="form-label fw-semibold">
                                Graduation Year
                            </label>

                            <input asp-for="GraduationYear"
                                   type="number"
                                   class="form-control"
                                   placeholder="e.g. 2027" />

                            <span asp-validation-for="GraduationYear"
                                  class="text-danger">
                            </span>

                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100 py-2">
                            Save Profile
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>