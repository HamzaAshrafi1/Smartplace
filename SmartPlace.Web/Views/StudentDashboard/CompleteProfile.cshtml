@model SmartPlace.Web.Services.StudentProfileRequest

@{
    ViewData["Title"] = "Academic Profile";

    var departments =
        ViewBag.Departments
        as List<SmartPlace.Web.Services.DepartmentItem>
        ?? new();

    var currentYear =
        DateTime.Now.Year;
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>
                    <h2 class="fw-bold mb-1">
                        Academic Profile
                    </h2>

                    <p class="text-muted mb-0">
                        Keep your academic information accurate.
                        SmartPlace uses these details to determine job eligibility.
                    </p>
                </div>

                <a asp-controller="StudentDashboard"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Dashboard
                </a>

            </div>


            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }


            @if (Model.TenthPercentage <= 0 ||
                 Model.TwelfthPercentage <= 0)
            {
                <div class="alert alert-warning">

                    <strong>
                        Academic profile incomplete.
                    </strong>

                    <div class="mt-1">
                        Please enter your 10th and 12th percentages.
                        These are required for placement eligibility checks.
                    </div>

                </div>
            }


            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-md-5">

                    <form asp-controller="StudentDashboard"
                          asp-action="CompleteProfile"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <h5 class="fw-bold mb-3">
                            School Academics
                        </h5>


                        <div class="row g-3 mb-4">

                            <div class="col-md-6">

                                <label asp-for="TenthPercentage"
                                       class="form-label">
                                    10th Standard Percentage
                                </label>

                                <div class="input-group">

                                    <input asp-for="TenthPercentage"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           max="100"
                                           class="form-control"
                                           placeholder="Example: 82.50"
                                           required />

                                    <span class="input-group-text">
                                        %
                                    </span>

                                </div>

                                <span asp-validation-for="TenthPercentage"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="TwelfthPercentage"
                                       class="form-label">
                                    12th Standard Percentage
                                </label>

                                <div class="input-group">

                                    <input asp-for="TwelfthPercentage"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           max="100"
                                           class="form-control"
                                           placeholder="Example: 76.40"
                                           required />

                                    <span class="input-group-text">
                                        %
                                    </span>

                                </div>

                                <span asp-validation-for="TwelfthPercentage"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <hr />


                        <h5 class="fw-bold mt-4 mb-3">
                            Degree Information
                        </h5>


                        <div class="row g-3">

                            <div class="col-md-6">

                                <label asp-for="CGPA"
                                       class="form-label">
                                    Current CGPA
                                </label>

                                <input asp-for="CGPA"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       max="10"
                                       class="form-control"
                                       placeholder="Example: 8.25"
                                       required />

                                <span asp-validation-for="CGPA"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="Backlogs"
                                       class="form-label">
                                    Current Backlogs
                                </label>

                                <input asp-for="Backlogs"
                                       type="number"
                                       min="0"
                                       class="form-control"
                                       placeholder="0"
                                       required />

                                <span asp-validation-for="Backlogs"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="GraduationYear"
                                       class="form-label">
                                    Graduation Year
                                </label>

                                <input asp-for="GraduationYear"
                                       type="number"
                                       min="@currentYear"
                                       max="@(currentYear + 10)"
                                       class="form-control"
                                       required />

                                <div class="form-text">
                                    Must be @currentYear or later.
                                </div>

                                <span asp-validation-for="GraduationYear"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="DepartmentId"
                                       class="form-label">
                                    Department / Branch
                                </label>

                                <select asp-for="DepartmentId"
                                        class="form-select"
                                        required>

                                    <option value="">
                                        Select department
                                    </option>

                                    @foreach (var department
                                              in departments)
                                    {
                                        <option value="@department.DepartmentId">
                                            @department.Name
                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="DepartmentId"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <div class="d-flex justify-content-end gap-2 mt-4">

                            <a asp-controller="StudentDashboard"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary px-4">
                                Save Academic Profile
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}