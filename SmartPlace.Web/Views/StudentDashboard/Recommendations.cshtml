@model SmartPlace.Web.Services.JobRecommendationResponse

@{
    ViewData["Title"] = "AI Job Recommendations";
}

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                AI Job Recommendations
            </h2>

            <p class="text-muted mb-0">
                Jobs ranked using your skills and academic eligibility.
            </p>
        </div>

        <a asp-controller="StudentDashboard"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>

    </div>


    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }


    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    @if (ViewBag.Error != null)
    {
        <div class="alert alert-warning">
            @ViewBag.Error
        </div>
    }


    @if (Model.Recommendations != null &&
         Model.Recommendations.Count > 0)
    {

        <!-- Student Skills -->
        <div class="card border-0 shadow-sm mb-4">

            <div class="card-body">

                <div class="d-flex justify-content-between
                    align-items-center">

                    <div>
                        <h5 class="fw-bold mb-1">
                            Your Skills
                        </h5>

                        <p class="text-muted small mb-0">
                            Skills used while calculating your job matches.
                        </p>
                    </div>

                    <span class="badge bg-primary">
                        @Model.StudentSkills.Count Skills
                    </span>

                </div>


                <div class="d-flex flex-wrap gap-2 mt-3">

                    @foreach (var skill in Model.StudentSkills)
                    {
                        <span class="badge bg-secondary p-2">
                            @skill
                        </span>
                    }

                </div>

            </div>

        </div>


        <!-- Jobs -->
        <div class="row g-4">

            @foreach (var job in Model.Recommendations)
            {
                <div class="col-lg-6">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body p-4">

                            <!-- Job Header -->
                            <div class="d-flex justify-content-between
                                align-items-start mb-3">

                                <div>

                                    <h4 class="fw-bold mb-1">
                                        @job.JobTitle
                                    </h4>

                                    <div class="text-muted">
                                        @(job.Company ?? "Company")
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(job.Location))
                                    {
                                        <div class="small text-muted mt-1">
                                            @job.Location
                                        </div>
                                    }

                                </div>


                                @if (job.AcademicallyEligible)
                                {
                                    <span class="badge bg-success">
                                        Eligible
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Not Eligible
                                    </span>
                                }

                            </div>


                            <!-- Match + Package -->
                            <div class="row mb-3">

                                <div class="col-6">

                                    <small class="text-muted">
                                        Match Score
                                    </small>

                                    <div class="fs-3 fw-bold">
                                        @job.MatchPercentage%
                                    </div>

                                </div>


                                <div class="col-6">

                                    <small class="text-muted">
                                        Package
                                    </small>

                                    <div class="fs-5 fw-bold mt-1">
                                        @job.Package
                                    </div>

                                </div>

                            </div>


                            <!-- Match Progress -->
                            <div class="progress mb-4"
                                 style="height: 10px;">

                                <div class="progress-bar"
                                     role="progressbar"
                                     style="width: @job.MatchPercentage%"
                                     aria-valuenow="@job.MatchPercentage"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                </div>

                            </div>


                            <!-- Recommendation -->
                            <div class="mb-3">

                                <small class="text-muted">
                                    Recommendation
                                </small>

                                <div class="fw-bold mt-1">
                                    @job.Recommendation
                                </div>

                            </div>


                            <!-- Matching Skills -->
                            <div class="mb-3">

                                <strong>
                                    Matching Skills
                                </strong>

                                <div class="d-flex flex-wrap gap-2 mt-2">

                                    @if (job.MatchingSkills != null &&
                                         job.MatchingSkills.Count > 0)
                                    {
                                        @foreach (var skill in job.MatchingSkills)
                                        {
                                            <span class="badge bg-success">
                                                @skill
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">
                                            No matching skills detected.
                                        </span>
                                    }

                                </div>

                            </div>


                            <!-- Missing Skills -->
                            <div>

                                <strong>
                                    Missing Skills
                                </strong>

                                <div class="d-flex flex-wrap gap-2 mt-2">

                                    @if (job.MissingSkills != null &&
                                         job.MissingSkills.Count > 0)
                                    {
                                        @foreach (var skill in job.MissingSkills)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @skill
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            No major skill gaps
                                        </span>
                                    }

                                </div>

                            </div>


                            <!-- Apply -->
                            <hr class="my-4" />

                            @if (job.AcademicallyEligible)
                            {
                                <form asp-controller="StudentDashboard"
                                      asp-action="Apply"
                                      method="post">

                                    <input type="hidden"
                                           name="jobId"
                                           value="@job.JobId" />

                                    <button type="submit"
                                            class="btn btn-primary w-100">
                                        Apply for this Job
                                    </button>

                                </form>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-secondary w-100"
                                        disabled>
                                    Not Academically Eligible
                                </button>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <!-- No Jobs -->
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <h5 class="fw-bold">
                    No Job Recommendations Available
                </h5>

                <p class="text-muted mb-3">
                    There are currently no published jobs
                    available for recommendation.
                </p>

                <a asp-controller="StudentDashboard"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                    Back to Dashboard
                </a>

            </div>

        </div>
    }

</div>