@model SmartPlace.Web.Controllers.ResumePageViewModel

@{
    ViewData["Title"] = "Resume & Skills";

    string? uploadedDateText = null;

    if (Model.Resume != null)
    {
        uploadedDateText =
            Model.Resume.UploadedAt
                .ToLocalTime()
                .ToString("dd MMM yyyy, hh:mm tt");
    }
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Resume & AI Skills
            </h2>

            <p class="text-muted mb-0">
                Upload your PDF resume and let SmartPlace
                detect your technical skills automatically.
            </p>

        </div>

        <a asp-controller="StudentDashboard"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <div class="row g-4">

        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-3">
                        Upload Resume
                    </h5>


                    <form asp-controller="StudentDashboard"
                          asp-action="UploadResume"
                          method="post"
                          enctype="multipart/form-data">

                        <div class="mb-3">

                            <label class="form-label">
                                Select PDF Resume
                            </label>

                            <input type="file"
                                   name="file"
                                   accept=".pdf,application/pdf"
                                   class="form-control"
                                   required />

                            <div class="form-text">
                                PDF only. Maximum size: 5 MB.
                            </div>

                        </div>


                        <button type="submit"
                                class="btn btn-primary">
                            Upload Resume
                        </button>

                    </form>


                    @if (Model.Resume != null)
                    {
                        <hr class="my-4" />

                        <h6 class="fw-bold mb-3">
                            Current Resume
                        </h6>


                        <p class="mb-2">

                            <strong>
                                File:
                            </strong>

                            @Model.Resume.FileName

                        </p>


                        <p class="mb-2">

                            <strong>
                                Uploaded:
                            </strong>

                            @uploadedDateText

                        </p>


                        <p class="mb-3">

                            <strong>
                                Processed:
                            </strong>

                            @if (Model.Resume.IsProcessed)
                            {
                                <span class="badge bg-success">
                                    Yes
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    No
                                </span>
                            }

                        </p>


                        <form asp-controller="StudentDashboard"
                              asp-action="ExtractSkills"
                              method="post">

                            <button type="submit"
                                    class="btn btn-success">
                                Extract Skills with AI
                            </button>

                        </form>
                    }

                </div>

            </div>

        </div>


        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <h5 class="fw-bold mb-0">
                            Detected Skills
                        </h5>

                        <span class="badge bg-primary">
                            @(Model.Skills?.Count ?? 0)
                        </span>

                    </div>


                    @if (Model.Skills != null &&
                         Model.Skills.Count > 0)
                    {
                        <div class="d-flex flex-wrap gap-2">

                            @foreach (var skill in Model.Skills)
                            {
                                <span class="badge bg-secondary fs-6 p-2">
                                    @skill
                                </span>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">

                            <h6 class="text-muted">
                                No skills detected yet
                            </h6>

                            <p class="text-muted small mb-0">
                                Upload your resume and run
                                AI skill extraction.
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>