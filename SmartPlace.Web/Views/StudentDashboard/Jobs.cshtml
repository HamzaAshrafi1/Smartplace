@model SmartPlace.Web.Controllers.StudentJobsPageViewModel

@{
    ViewData["Title"] = "Jobs";

    var eligibleJobs =
        Model.Jobs.Jobs
            .Where(j => j.Eligible)
            .ToList();

    var notEligibleJobs =
        Model.Jobs.Jobs
            .Where(j => !j.Eligible)
            .ToList();
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Jobs & Eligibility
            </h2>

            <p class="text-muted mb-0">
                Explore published jobs, check academic eligibility,
                and view AI-ranked recommendations.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Dashboard
        </a>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-warning">
            @ViewBag.Error
        </div>
    }


    <!-- COUNTERS -->

    <div class="row g-3 mb-4">

        <div class="col-md-3">

            <div class="card border-0 shadow-sm">
                <div class="card-body">

                    <small class="text-muted">
                        All Jobs
                    </small>

                    <div class="fs-2 fw-bold">
                        @Model.Jobs.TotalJobs
                    </div>

                </div>
            </div>

        </div>

        <div class="col-md-3">

            <div class="card border-0 shadow-sm">
                <div class="card-body">

                    <small class="text-muted">
                        Eligible
                    </small>

                    <div class="fs-2 fw-bold text-success">
                        @Model.Jobs.EligibleCount
                    </div>

                </div>
            </div>

        </div>

        <div class="col-md-3">

            <div class="card border-0 shadow-sm">
                <div class="card-body">

                    <small class="text-muted">
                        Not Eligible
                    </small>

                    <div class="fs-2 fw-bold text-danger">
                        @Model.Jobs.NotEligibleCount
                    </div>

                </div>
            </div>

        </div>

        <div class="col-md-3">

            <div class="card border-0 shadow-sm">
                <div class="card-body">

                    <small class="text-muted">
                        AI Recommendations
                    </small>

                    <div class="fs-2 fw-bold text-primary">
                        @Model.Recommendations.Recommendations.Count
                    </div>

                </div>
            </div>

        </div>

    </div>


    <!-- TABS -->

    <ul class="nav nav-tabs mb-4"
        id="jobTabs"
        role="tablist">

        <li class="nav-item">

            <button class="nav-link active"
                    data-bs-toggle="tab"
                    data-bs-target="#allJobs"
                    type="button">

                All Jobs

            </button>

        </li>

        <li class="nav-item">

            <button class="nav-link"
                    data-bs-toggle="tab"
                    data-bs-target="#eligibleJobs"
                    type="button">

                Eligible

            </button>

        </li>

        <li class="nav-item">

            <button class="nav-link"
                    data-bs-toggle="tab"
                    data-bs-target="#notEligibleJobs"
                    type="button">

                Not Eligible

            </button>

        </li>

        <li class="nav-item">

            <button class="nav-link"
                    data-bs-toggle="tab"
                    data-bs-target="#aiJobs"
                    type="button">

                AI Recommended

            </button>

        </li>

    </ul>


    <div class="tab-content">

        <!-- ==========================================
             ALL JOBS
        =========================================== -->

        <div class="tab-pane fade show active"
             id="allJobs">

            @if (Model.Jobs.Jobs.Count == 0)
            {
                <div class="alert alert-info">
                    No published jobs are currently available.
                </div>
            }

            <div class="row g-4">

                @foreach (var job in Model.Jobs.Jobs)
                {
                    <div class="col-lg-6">

                        <div class="card border-0 shadow-sm h-100">

                            <div class="card-body p-4">

                                <div class="d-flex justify-content-between align-items-start">

                                    <div>

                                        <h4 class="fw-bold">
                                            @job.Title
                                        </h4>

                                        <div class="text-muted">
                                            @(job.Company ?? "Company")
                                        </div>

                                    </div>

                                    @if (job.Eligible)
                                    {
                                        <span class="badge bg-success">
                                            Eligible
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Not Eligible
                                        </span>
                                    }

                                </div>


                                <div class="row g-3 mt-2">

                                    <div class="col-6">
                                        <small class="text-muted">
                                            Package
                                        </small>

                                        <div class="fw-bold">
                                            @job.Package
                                        </div>
                                    </div>

                                    <div class="col-6">
                                        <small class="text-muted">
                                            Location
                                        </small>

                                        <div class="fw-bold">
                                            @(job.Location ?? "Not specified")
                                        </div>
                                    </div>

                                </div>


                                <hr />


                                <strong>
                                    Eligibility Requirements
                                </strong>

                                <div class="small mt-2">

                                    <div>
                                        Branch:
                                        <strong>
                                            @(job.Requirements.Department
                                                ?? "Not configured")
                                        </strong>
                                    </div>

                                    <div>
                                        10th:
                                        <strong>
                                            @job.Requirements.MinimumTenthPercentage%
                                        </strong>
                                        or above
                                    </div>

                                    <div>
                                        12th:
                                        <strong>
                                            @job.Requirements.MinimumTwelfthPercentage%
                                        </strong>
                                        or above
                                    </div>

                                    <div>
                                        CGPA:
                                        <strong>
                                            @job.Requirements.MinimumCGPA
                                        </strong>
                                        or above
                                    </div>

                                    <div>
                                        Backlogs:
                                        maximum
                                        <strong>
                                            @job.Requirements.MaximumBacklogs
                                        </strong>
                                    </div>

                                    <div>
                                        Graduation:
                                        <strong>
                                            @job.Requirements.GraduationYear
                                        </strong>
                                    </div>

                                </div>


                                @if (job.Eligible)
                                {
                                    <form asp-action="Apply"
                                          method="post"
                                          class="mt-4">

                                        <input type="hidden"
                                               name="jobId"
                                               value="@job.JobId" />

                                        <button class="btn btn-primary w-100">
                                            Apply for Job
                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-secondary w-100 mt-4"
                                            disabled>
                                        Not Eligible
                                    </button>
                                }

                            </div>

                        </div>

                    </div>
                }

            </div>

        </div>


        <!-- ==========================================
             ELIGIBLE JOBS
        =========================================== -->

        <div class="tab-pane fade"
             id="eligibleJobs">

            @if (eligibleJobs.Count == 0)
            {
                <div class="alert alert-info">
                    You currently do not meet the academic
                    requirements for any published job.
                </div>
            }

            <div class="row g-4">

                @foreach (var job in eligibleJobs)
                {
                    <div class="col-lg-6">

                        <div class="card border-0 shadow-sm h-100">

                            <div class="card-body p-4">

                                <span class="badge bg-success mb-2">
                                    Eligible
                                </span>

                                <h4 class="fw-bold">
                                    @job.Title
                                </h4>

                                <p class="text-muted">
                                    @(job.Company ?? "Company")
                                </p>


                                <div class="row g-3">

                                    <div class="col-sm-6">

                                        <small class="text-muted">
                                            Package
                                        </small>

                                        <div class="fw-bold">
                                            @job.Package
                                        </div>

                                    </div>

                                    <div class="col-sm-6">

                                        <small class="text-muted">
                                            Location
                                        </small>

                                        <div class="fw-bold">
                                            @(job.Location ?? "Not specified")
                                        </div>

                                    </div>

                                </div>


                                <form asp-action="Apply"
                                      method="post"
                                      class="mt-4">

                                    <input type="hidden"
                                           name="jobId"
                                           value="@job.JobId" />

                                    <button class="btn btn-primary w-100">
                                        Apply for Job
                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>
                }

            </div>

        </div>


        <!-- ==========================================
             NOT ELIGIBLE
        =========================================== -->

        <div class="tab-pane fade"
             id="notEligibleJobs">

            @if (notEligibleJobs.Count == 0)
            {
                <div class="alert alert-success">
                    You meet the academic requirements
                    for every currently published job.
                </div>
            }

            <div class="row g-4">

                @foreach (var job in notEligibleJobs)
                {
                    <div class="col-lg-6">

                        <div class="card border-0 shadow-sm h-100">

                            <div class="card-body p-4">

                                <span class="badge bg-danger mb-2">
                                    Not Eligible
                                </span>

                                <h4 class="fw-bold">
                                    @job.Title
                                </h4>

                                <p class="text-muted">
                                    @(job.Company ?? "Company")
                                </p>


                                <h6 class="fw-bold mt-4">
                                    Why you're not eligible
                                </h6>

                                @if (job.Reasons.Count > 0)
                                {
                                    <ul class="mb-0">

                                        @foreach (var reason
                                                  in job.Reasons)
                                        {
                                            <li class="text-danger mb-1">
                                                @reason
                                            </li>
                                        }

                                    </ul>
                                }
                                else
                                {
                                    <p class="text-muted mb-0">
                                        Eligibility requirements were not met.
                                    </p>
                                }

                            </div>

                        </div>

                    </div>
                }

            </div>

        </div>


        <!-- ==========================================
             AI RECOMMENDATIONS
        =========================================== -->

        <div class="tab-pane fade"
             id="aiJobs">

            @if (Model.Profile.Skills.Count == 0)
            {
                <div class="alert alert-warning">

                    Upload your resume and extract skills
                    before using AI job recommendations.

                    <div class="mt-3">

                        <a asp-action="Resume"
                           class="btn btn-warning">
                            Manage Resume
                        </a>

                    </div>

                </div>
            }
            else if (
                Model.Recommendations.Recommendations.Count == 0)
            {
                <div class="alert alert-info">
                    There are currently no academically eligible
                    jobs available for AI recommendation.
                </div>
            }
            else
            {
                <div class="alert alert-primary">

                    <strong>
                        AI ranking is applied only after
                        academic eligibility.
                    </strong>

                    <div class="small mt-1">
                        These jobs already satisfy your branch,
                        10th, 12th, CGPA, backlog and graduation
                        requirements.
                    </div>

                </div>


                <div class="row g-4">

                    @{
                        var rank = 1;
                    }

                    @foreach (var job
                              in Model.Recommendations.Recommendations)
                    {
                        <div class="col-lg-6">

                            <div class="card border-0 shadow-sm h-100">

                                <div class="card-body p-4">

                                    <div class="d-flex justify-content-between">

                                        <div>

                                            <span class="badge bg-primary mb-2">
                                                #@rank Recommendation
                                            </span>

                                            <h4 class="fw-bold">
                                                @job.JobTitle
                                            </h4>

                                            <div class="text-muted">
                                                @(job.Company ?? "Company")
                                            </div>

                                        </div>

                                        <div class="text-end">

                                            <small class="text-muted">
                                                Skill Match
                                            </small>

                                            <div class="fs-3 fw-bold text-primary">
                                                @job.MatchPercentage%
                                            </div>

                                        </div>

                                    </div>


                                    <div class="progress my-3"
                                         style="height: 9px;">

                                        <div class="progress-bar"
                                             style="width: @job.MatchPercentage%">
                                        </div>

                                    </div>


                                    <div class="mb-3">

                                        <strong>
                                            Matching Skills
                                        </strong>

                                        <div class="d-flex flex-wrap gap-2 mt-2">

                                            @foreach (var skill
                                                      in job.MatchingSkills)
                                            {
                                                <span class="badge bg-success">
                                                    @skill
                                                </span>
                                            }

                                        </div>

                                    </div>


                                    <div>

                                        <strong>
                                            Missing Skills
                                        </strong>

                                        <div class="d-flex flex-wrap gap-2 mt-2">

                                            @if (job.MissingSkills.Count == 0)
                                            {
                                                <span class="badge bg-success">
                                                    No major skill gap
                                                </span>
                                            }
                                            else
                                            {
                                                @foreach (var skill
                                                          in job.MissingSkills)
                                                {
                                                    <span class="badge bg-warning text-dark">
                                                        @skill
                                                    </span>
                                                }
                                            }

                                        </div>

                                    </div>


                                    <form asp-action="Apply"
                                          method="post"
                                          class="mt-4">

                                        <input type="hidden"
                                               name="jobId"
                                               value="@job.JobId" />

                                        <button class="btn btn-primary w-100">
                                            Apply for Job
                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                        rank++;
                    }

                </div>
            }

        </div>

    </div>

</div>