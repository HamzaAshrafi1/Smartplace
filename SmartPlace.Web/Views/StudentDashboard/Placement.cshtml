@model SmartPlace.Web.Services.StudentPlacementInfo

@{
    ViewData["Title"] = "Placement Status";

    var joiningDateText =
        Model?.JoiningDate.HasValue == true
            ? Model.JoiningDate.Value.ToString("dd MMM yyyy")
            : "Not announced";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Placement Status
            </h2>

            <p class="text-muted mb-0">
                Your final placement and joining information.
            </p>
        </div>

        <a asp-controller="StudentDashboard"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Dashboard
        </a>

    </div>

    @if (Model == null)
    {
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <h4 class="fw-bold">
                    No Placement Record Yet
                </h4>

                <p class="text-muted mb-0">
                    Your placement details will appear here
                    once recorded.
                </p>

            </div>

        </div>
    }
    else
    {
        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="card border-0 shadow-sm">

                    <div class="card-body p-5">

                        <div class="text-center mb-4">

                            <span class="badge bg-success fs-6 mb-3">
                                @Model.Status
                            </span>

                            <h2 class="fw-bold">
                                @(Model.Company?.Name ?? "Company")
                            </h2>

                            <p class="text-muted">
                                Congratulations on your placement.
                            </p>

                        </div>

                        <div class="row g-4">

                            <div class="col-md-6">

                                <div class="border rounded p-3">

                                    <small class="text-muted">
                                        Offered Package
                                    </small>

                                    <div class="fs-4 fw-bold">
                                        @Model.OfferedPackage
                                    </div>

                                </div>

                            </div>

                            <div class="col-md-6">

                                <div class="border rounded p-3">

                                    <small class="text-muted">
                                        Joining Date
                                    </small>

                                    <div class="fs-5 fw-bold">
                                        @joiningDateText
                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="row g-4 mt-1">

                            <div class="col-md-6">

                                <div class="border rounded p-3">

                                    <small class="text-muted">
                                        Placement Status
                                    </small>

                                    <div class="fw-bold">
                                        @Model.Status
                                    </div>

                                </div>

                            </div>

                            <div class="col-md-6">

                                <div class="border rounded p-3">

                                    <small class="text-muted">
                                        Company
                                    </small>

                                    <div class="fw-bold">
                                        @(Model.Company?.Name ?? "Not specified")
                                    </div>

                                </div>

                            </div>

                        </div>

                        @if (!string.IsNullOrWhiteSpace(
                            Model.OfferLetterUrl))
                        {
                            <div class="text-center mt-4">

                                <a href="@Model.OfferLetterUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="btn btn-primary">
                                    View Offer Letter
                                </a>

                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>
    }

</div>