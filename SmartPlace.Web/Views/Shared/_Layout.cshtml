<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - SmartPlace
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/SmartPlace.Web.styles.css"
          asp-append-version="true" />

</head>

<body>

    @{
        var token =
            Context.Session.GetString("JWToken");

        var role =
            Context.Session.GetString("UserRole");

        var name =
            Context.Session.GetString("UserName");

        string dashboardController =
            role switch
            {
                "Student" =>
                    "StudentDashboard",

                "Recruiter" =>
                    "RecruiterDashboard",

                "PlacementOfficer" =>
                    "PlacementDashboard",

                "Admin" =>
                    "AdminDashboard",

                _ =>
                    "Home"
            };
    }


    <header>

        <nav class="navbar navbar-expand-lg
            navbar-light bg-white
            border-bottom shadow-sm">

            <div class="container">

                <a class="navbar-brand fw-bold"
                   asp-controller="@dashboardController"
                   asp-action="Index">
                    SmartPlace
                </a>


                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNav">

                    <span class="navbar-toggler-icon">
                    </span>

                </button>


                <div id="mainNav"
                     class="collapse navbar-collapse">


                    @if (!string.IsNullOrWhiteSpace(token))
                    {
                        <ul class="navbar-nav me-auto">

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="@dashboardController"
                                   asp-action="Index">
                                    Dashboard
                                </a>

                            </li>


                            @if (role == "Student")
                            {
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="StudentDashboard"
                                       asp-action="Jobs">
                                        Jobs
                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="StudentDashboard"
                                       asp-action="MyApplications">
                                        Applications
                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="StudentDashboard"
                                       asp-action="Interviews">
                                        Interviews
                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="StudentDashboard"
                                       asp-action="Placement">
                                        Placement
                                    </a>

                                </li>
                            }


                            @if (role == "Admin")
                            {
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="AdminDashboard"
                                       asp-action="Users">
                                        User Management
                                    </a>

                                </li>
                            }

                        </ul>


                        <ul class="navbar-nav ms-auto">

                            <li class="nav-item
                                d-flex align-items-center me-3">

                                <span class="text-muted">

                                    @name
                                    ·
                                    @role

                                </span>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link text-danger"
                                   asp-controller="Account"
                                   asp-action="Logout">
                                    Logout
                                </a>

                            </li>

                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto">

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Login
                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Register
                                </a>

                            </li>

                        </ul>
                    }

                </div>

            </div>

        </nav>

    </header>


    <main class="container py-3">

        @RenderBody()

    </main>


    <footer class="border-top text-muted mt-5">

        <div class="container py-3">

            &copy; 2026 SmartPlace ·
            AI-Powered College Placement Management System

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js">
    </script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>