@model SmartPlace.Web.Controllers.AdminDashboardViewModel

@{
    ViewData["Title"] =
        "Admin Dashboard";

    var pendingCompanies =
        Model.Companies
            .Count(c =>
                c.ApprovalStatus == "Pending");

    var pendingJobs =
        Model.Jobs
            .Count(j =>
                j.Status == "Pending");
}

<div class="container py-4">

    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            Admin Dashboard
        </h2>

        <p class="text-muted mb-0">
            System-wide SmartPlace administration and oversight.
        </p>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <div class="row g-3 mb-4">

        <div class="col-md">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <small class="text-muted">
                        Students
                    </small>

                    <div class="fs-2 fw-bold">
                        @Model.Students.Count
                    </div>

                </div>

            </div>

        </div>


        <div class="col-md">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <small class="text-muted">
                        Companies
                    </small>

                    <div class="fs-2 fw-bold">
                        @Model.Companies.Count
                    </div>

                </div>

            </div>

        </div>


        <div class="col-md">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <small class="text-muted">
                        Jobs
                    </small>

                    <div class="fs-2 fw-bold">
                        @Model.Jobs.Count
                    </div>

                </div>

            </div>

        </div>


        <div class="col-md">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <small class="text-muted">
                        Applications
                    </small>

                    <div class="fs-2 fw-bold">
                        @Model.Applications.Count
                    </div>

                </div>

            </div>

        </div>


        <div class="col-md">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <small class="text-muted">
                        Placements
                    </small>

                    <div class="fs-2 fw-bold text-success">
                        @Model.Placements.Count
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- COMPANY APPROVAL -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <h4 class="fw-bold mb-3">
                Company Management
                <span class="badge bg-warning text-dark ms-2">
                    @pendingCompanies Pending
                </span>
            </h4>


            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>

                        <tr>
                            <th>Company</th>
                            <th>Industry</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var company
                                  in Model.Companies)
                        {
                            <tr>

                                <td class="fw-semibold">
                                    @company.Name
                                </td>

                                <td>
                                    @company.Industry
                                </td>

                                <td>
                                    @company.Location
                                </td>

                                <td>
                                    @company.ApprovalStatus
                                </td>

                                <td>

                                    <form asp-action="CompanyApproval"
                                          method="post"
                                          class="d-flex gap-2">

                                        <input type="hidden"
                                               name="id"
                                               value="@company.CompanyId" />

                                        <button name="status"
                                                value="Approved"
                                                class="btn btn-sm btn-success">
                                            Approve
                                        </button>

                                        <button name="status"
                                                value="Rejected"
                                                class="btn btn-sm btn-outline-danger">
                                            Reject
                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- JOB MANAGEMENT -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <h4 class="fw-bold mb-3">
                Job Management
                <span class="badge bg-warning text-dark ms-2">
                    @pendingJobs Pending
                </span>
            </h4>


            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>

                        <tr>
                            <th>Job</th>
                            <th>Company</th>
                            <th>Branch</th>
                            <th>10th</th>
                            <th>12th</th>
                            <th>CGPA</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var job
                                  in Model.Jobs)
                        {
                            <tr>

                                <td>
                                    @job.Title
                                </td>

                                <td>
                                    @job.Company?.Name
                                </td>

                                <td>
                                    @(job.RequiredDepartment?.Name
                                        ?? "Not configured")
                                </td>

                                <td>
                                    @job.MinimumTenthPercentage%
                                </td>

                                <td>
                                    @job.MinimumTwelfthPercentage%
                                </td>

                                <td>
                                    @job.MinimumCGPA
                                </td>

                                <td>
                                    @job.Status
                                </td>

                                <td>

                                    <form asp-action="JobStatus"
                                          method="post"
                                          class="d-flex flex-wrap gap-2">

                                        <input type="hidden"
                                               name="id"
                                               value="@job.JobId" />

                                        <button name="status"
                                                value="Published"
                                                class="btn btn-sm btn-success">
                                            Publish
                                        </button>

                                        <button name="status"
                                                value="Rejected"
                                                class="btn btn-sm btn-outline-danger">
                                            Reject
                                        </button>

                                        <button name="status"
                                                value="Closed"
                                                class="btn btn-sm btn-secondary">
                                            Close
                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- STUDENTS -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <h4 class="fw-bold mb-3">
                Students
            </h4>


            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>

                        <tr>
                            <th>Student</th>
                            <th>Branch</th>
                            <th>10th</th>
                            <th>12th</th>
                            <th>CGPA</th>
                            <th>Backlogs</th>
                            <th>Graduation</th>
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var student
                                  in Model.Students)
                        {
                            <tr>

                                <td>

                                    <div class="fw-semibold">
                                        @student.FullName
                                    </div>

                                    <small class="text-muted">
                                        @student.Email
                                    </small>

                                </td>

                                <td>
                                    @student.Department?.Name
                                </td>

                                <td>
                                    @student.TenthPercentage%
                                </td>

                                <td>
                                    @student.TwelfthPercentage%
                                </td>

                                <td>
                                    @student.CGPA
                                </td>

                                <td>
                                    @student.Backlogs
                                </td>

                                <td>
                                    @student.GraduationYear
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- APPLICATIONS -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <h4 class="fw-bold mb-3">
                Applications
            </h4>


            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>

                        <tr>
                            <th>Student</th>
                            <th>Job</th>
                            <th>Company</th>
                            <th>Status</th>
                            <th>Applied</th>
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var application
                                  in Model.Applications
                                      .OrderByDescending(
                                          a => a.AppliedDate))
                        {
                            <tr>

                                <td>
                                    @application.Student?.FullName
                                </td>

                                <td>
                                    @application.Job?.Title
                                </td>

                                <td>
                                    @application.Job?.Company?.Name
                                </td>

                                <td>
                                    @application.Status
                                </td>

                                <td>
                                    @application.AppliedDate
                                    .ToLocalTime()
                                    .ToString("dd MMM yyyy")
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- PLACEMENTS -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <h4 class="fw-bold mb-3">
                Placements
            </h4>


            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>

                        <tr>
                            <th>Student</th>
                            <th>Company</th>
                            <th>Package</th>
                            <th>Joining</th>
                            <th>Status</th>
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var placement
                                  in Model.Placements)
                        {
                            <tr>

                                <td>
                                    @placement.Student?.FullName
                                </td>

                                <td>
                                    @placement.Company?.Name
                                </td>

                                <td>
                                    @placement.OfferedPackage
                                </td>

                                <td>
                                    @(placement.JoiningDate?
                                        .ToString("dd MMM yyyy")
                                        ?? "Not announced")
                                </td>

                                <td>
                                    @placement.Status
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- MASTER DATA -->

    <div class="row g-4">

        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <h4 class="fw-bold">
                        Departments
                    </h4>

                    <form asp-action="CreateDepartment"
                          method="post"
                          class="d-flex gap-2 mt-3 mb-4">

                        <input name="name"
                               class="form-control"
                               placeholder="Department"
                               required />

                        <button class="btn btn-primary">
                            Add
                        </button>

                    </form>


                    <div class="d-flex flex-wrap gap-2">

                        @foreach (var department
                                  in Model.Departments)
                        {
                            <span class="badge bg-secondary p-2">
                                @department.Name
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>


        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <h4 class="fw-bold">
                        Skills
                    </h4>

                    <form asp-action="CreateSkill"
                          method="post"
                          class="d-flex gap-2 mt-3 mb-4">

                        <input name="name"
                               class="form-control"
                               placeholder="Skill"
                               required />

                        <button class="btn btn-primary">
                            Add
                        </button>

                    </form>


                    <div class="d-flex flex-wrap gap-2">

                        @foreach (var skill
                                  in Model.Skills)
                        {
                            <span class="badge bg-secondary p-2">
                                @skill.Name
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>