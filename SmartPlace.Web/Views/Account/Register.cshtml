@model SmartPlace.Web.Services.RegisterRequest

@{
    ViewData["Title"] = "Register";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-7 col-lg-6">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">

                        <h2 class="fw-bold">
                            Create Account
                        </h2>

                        <p class="text-muted mb-0">
                            Join SmartPlace as a student
                            or recruiter.
                        </p>

                    </div>


                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.Error
                        </div>
                    }


                    <form asp-controller="Account"
                          asp-action="Register"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <div class="mb-3">

                            <label asp-for="FullName"
                                   class="form-label">
                                Full Name
                            </label>

                            <input asp-for="FullName"
                                   class="form-control"
                                   autocomplete="name"
                                   placeholder="Enter your full name"
                                   required />

                            <span asp-validation-for="FullName"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label">
                                Email Address
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   autocomplete="email"
                                   placeholder="name@example.com"
                                   required />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="Password"
                                   class="form-label">
                                Password
                            </label>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   minlength="6"
                                   required />

                            <span asp-validation-for="Password"
                                  class="text-danger">
                            </span>


                            <div class="card bg-light border-0 mt-3">

                                <div class="card-body py-3">

                                    <div class="fw-semibold small mb-2">
                                        Password must contain:
                                    </div>

                                    <div class="small text-muted">

                                        <div>
                                            ✓ At least 6 characters
                                        </div>

                                        <div>
                                            ✓ At least one uppercase letter
                                        </div>

                                        <div>
                                            ✓ At least one lowercase letter
                                        </div>

                                        <div>
                                            ✓ At least one number
                                        </div>

                                        <div>
                                            ✓ At least one special character
                                            such as
                                            <strong>
                                                ! @@ # $ % ^ & *
                                            </strong>
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <div class="mb-4">

                            <label asp-for="Role"
                                   class="form-label">
                                Register As
                            </label>

                            <select asp-for="Role"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Select account type
                                </option>

                                <option value="Student">
                                    Student
                                </option>

                                <option value="Recruiter">
                                    Recruiter
                                </option>

                            </select>

                            <span asp-validation-for="Role"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Admin and Placement Officer accounts
                                are managed by SmartPlace.
                            </div>

                        </div>


                        <button type="submit"
                                class="btn btn-primary w-100 py-2">
                            Create Account
                        </button>

                    </form>


                    <div class="text-center mt-4">

                        <span class="text-muted">
                            Already have an account?
                        </span>

                        <a asp-controller="Account"
                           asp-action="Login"
                           class="text-decoration-none">
                            Login
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}