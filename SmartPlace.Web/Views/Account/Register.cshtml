@model SmartPlace.Web.Services.RegisterRequest

@{
    ViewData["Title"] = "Register";
}

<div class="auth-page">

    <div class="auth-container"
         style="
        max-width: 720px;
        margin: 0 auto;
        ">

        <div class="auth-shell">

            <div class="auth-form-panel
                auth-register-panel"
                 style="min-height: auto;">

                <div class="text-center mb-4">

                    <div class="auth-logo mx-auto mb-3">
                        SP
                    </div>

                    <div class="auth-eyebrow text-primary mb-2">
                        Get Started
                    </div>

                    <h2 class="fw-bold mb-2">
                        Create your account
                    </h2>

                    <p class="text-muted mb-0">
                        Register as a student or recruiter
                        to get started with SmartPlace.
                    </p>

                </div>


                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">
                        @ViewBag.Error
                    </div>
                }


                <form asp-controller="Account"
                      asp-action="Register"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <div class="row g-3">

                        <!-- FULL NAME -->

                        <div class="col-12">

                            <label asp-for="FullName"
                                   class="form-label fw-semibold">
                                Full Name
                            </label>

                            <input asp-for="FullName"
                                   class="form-control form-control-lg"
                                   autocomplete="name"
                                   placeholder="Enter your full name"
                                   required />

                            <span asp-validation-for="FullName"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- EMAIL -->

                        <div class="col-12">

                            <label asp-for="Email"
                                   class="form-label fw-semibold">
                                Email Address
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control form-control-lg"
                                   autocomplete="email"
                                   placeholder="name@example.com"
                                   required />

                            <span asp-validation-for="Email"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- ROLE -->

                        <div class="col-12">

                            <label asp-for="Role"
                                   class="form-label fw-semibold">
                                Register As
                            </label>

                            <select asp-for="Role"
                                    class="form-select form-select-lg"
                                    required>

                                <option value="">
                                    Select account type
                                </option>

                                <option value="Student">
                                    Student
                                </option>

                                <option value="Recruiter">
                                    Recruiter
                                </option>

                            </select>

                            <span asp-validation-for="Role"
                                  class="text-danger small">
                            </span>

                            <div class="form-text">
                                Admin and Placement Officer
                                accounts are managed internally
                                by SmartPlace.
                            </div>

                        </div>


                        <!-- PASSWORD -->

                        <div class="col-12">

                            <label asp-for="Password"
                                   class="form-label fw-semibold">
                                Password
                            </label>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control form-control-lg"
                                   autocomplete="new-password"
                                   minlength="6"
                                   placeholder="Create a strong password"
                                   required />

                            <span asp-validation-for="Password"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>


                    <!-- PASSWORD RULES -->

                    <div class="password-requirements mt-3">

                        <div class="fw-semibold mb-2">
                            Password requirements
                        </div>

                        <div class="row g-2 small">

                            <div class="col-sm-6">

                                <span class="requirement-check">
                                    ✓
                                </span>

                                Minimum 6 characters

                            </div>

                            <div class="col-sm-6">

                                <span class="requirement-check">
                                    ✓
                                </span>

                                Uppercase letter

                            </div>

                            <div class="col-sm-6">

                                <span class="requirement-check">
                                    ✓
                                </span>

                                Lowercase letter

                            </div>

                            <div class="col-sm-6">

                                <span class="requirement-check">
                                    ✓
                                </span>

                                At least one number

                            </div>

                            <div class="col-12">

                                <span class="requirement-check">
                                    ✓
                                </span>

                                Special character such as

                                <strong>
                                    ! @@ # $ % ^ & *
                                </strong>

                            </div>

                        </div>

                    </div>


                    <button type="submit"
                            class="btn
                        btn-primary
                        btn-lg
                        w-100
                        auth-submit-btn
                        mt-4">

                        Create Account

                    </button>

                </form>


                <div class="text-center mt-4">

                    <span class="text-muted">
                        Already have an account?
                    </span>

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="fw-semibold">

                        Sign In

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}